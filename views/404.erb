<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>404 - Page Not Found</title>
  <link rel="stylesheet" href="/css/404.css">
</head>

<body class="error-page-body">
  <div class="error-page-container">
    <div class="error-card">
      <h1 class="error-code">404</h1>
      <h2 class="error-title">Oops! This page doesn’t exist</h2>
      <p class="error-text">
        Looks like the page you were trying to reach has gone missing.
        Maybe the link is broken, or the page has been moved.
      </p>

      <div class="error-buttons">
        <a href="/" class="error-btn primary-btn">Go Home</a>
        <a href="/help_form.erb" class="error-btn secondary-btn">Help Page</a>
      </div>
    </div>
  </div>
</body>

</html>